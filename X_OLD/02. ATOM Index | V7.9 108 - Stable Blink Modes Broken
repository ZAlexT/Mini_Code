        divInterno.style.backgroundImage = "none";
        divInterno.style.background = "#5a5a5a";
        divInterno.style.backgroundColor = "#5a5a5a";
        doc.querySelectorAll("td").forEach(td => td.style.color = "#ffffff");
    } catch (e) {}
}

