// =============================================================
// 6. PARSE FECHA
// =============================================================

function parseFecha(text) {

    if (!/^\d{2}\/\d{2}\/\d{4}/.test(text))
        return null;

    const [f, h] = text.split(" ");

    if (!h)
        return null;

    const [d, m, y] = f.split("/").map(Number);
    const [hh, mm, ss] = h.split(":").map(Number);

    return new Date(y, m - 1, d, hh, mm, ss);
}


// =============================================================
// 7. FUNCIÓN DE COLOR
//
// 107 — PROTECCIÓN DOBLE PROCESO
// Coloreado con parpadeo.
//
// Se marca cada elemento procesado para impedir que el mismo
// elemento sea coloreado nuevamente por el MutationObserver.
// =============================================================

function aplicarEntrada(td, entrada) {

    if (!td || !entrada)
        return;

    // ---------------------------------------------------------
    // PROTECCIÓN DOBLE PROCESO
    // ---------------------------------------------------------

    if (td.dataset.lxProcesado === "1")
        return;


    const textoOriginal = td.textContent;

    if (!textoOriginal)
        return;


    const safe = entrada.texto
        .replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    const reg = new RegExp(`(${safe})`, "gi");

    if (!reg.test(textoOriginal))
        return;


    // ---------------------------------------------------------
    // COLOREADO + PARPADEO
    // ---------------------------------------------------------

    let html = td.innerHTML;

    html = html.replace(reg, match => {

        let estilos =
            `color:${entrada.color}; white-space:nowrap;`;

        if (CONFIG.fondoEstados && entrada.fondo) {

            estilos += `
                background:${entrada.fondo};
                box-decoration-break:clone;
                -webkit-box-decoration-break:clone;
                padding:1px 3px;
                border-radius:3px;
                line-height:1;
            `;
        }

        const lower = match.toLowerCase();

        let clases = "Lx-noblink";


        // -----------------------------------------------------
        // MODO DE PARPADEO
        // -----------------------------------------------------

        if (MODO_PARPADEO === "constante") {

            clases = "Lx-blink";

        }

        else if (MODO_PARPADEO === "intermitente") {

            clases = "Lx-blink";

        }

        else if (MODO_PARPADEO === "independiente") {

            if (
                ["assigned", "in progress"].includes(lower) ||
                usuariosBlink.includes(lower)
            ) {
                clases = "Lx-blink";
            }

            // 107 — HIGH: color de entrada + parpadeo
            if (lower === "high") {
                clases = "Lx-blink";
            }
        }


        return `<span class="${clases}" style="${estilos}">${match}</span>`;
    });


    td.innerHTML = html;

    // ---------------------------------------------------------
    // 107 — MARCA DE PROCESADO
    // ---------------------------------------------------------

    td.dataset.lxProcesado = "1";
}


// =============================================================
// 8. PROCESAR ENTRADAS DE UNA COLUMNA
// =============================================================

function procesarEntradas(td, entradas) {

    if (!td || !entradas || !entradas.length)
        return;

    entradas.forEach(entrada => {

        aplicarEntrada(td, entrada);

    });
}


