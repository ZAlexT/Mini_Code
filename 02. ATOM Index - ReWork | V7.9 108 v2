    // ---------------------------------------------------------

    procesarRequestID(requestID);


    // ---------------------------------------------------------
    // SUBMIT DATE
    // ---------------------------------------------------------

    if (submitDate) {

        const fecha =
            parseFecha(submitDate.textContent.trim());

        if (fecha) {

            const ahora = new Date();

